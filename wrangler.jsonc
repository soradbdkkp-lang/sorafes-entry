{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sorafes-entry",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ADMIN_AUTH", "class_name": "AdminAuth" }]
  },
  "migrations": [{ "tag": "admin-auth-v1", "new_sqlite_classes": ["AdminAuth"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "secrets": {
    "required": ["SORAFES_PRODUCTION_APPS_SCRIPT_URL"]
  }
}
