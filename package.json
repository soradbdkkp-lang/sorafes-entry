{
  "name": "sorafes-entry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:cloudflare": "npm run build && node scripts/run-cloudflare-local.mjs",
    "build": "tsc --noEmit && vite build",
    "build:cloudflare": "npm run build && wrangler deploy --dry-run",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/build-apps-script.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "build:apps-script": "node scripts/build-apps-script.mjs",
    "build:production-apps-script": "node scripts/build-production-apps-script.mjs",
    "build:production-web": "node scripts/build-production-web.mjs",
    "build:production": "npm run build:production-apps-script && npm run build:production-web"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wrangler": "^4.149.0"
  }
}
